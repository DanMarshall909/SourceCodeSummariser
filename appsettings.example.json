{
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
    "Model": "gpt-3.5-turbo",
    "MaxTokens": 50,
    "TimeoutSeconds": 30
  },
  "Database": {
